# Copy to .env. Keep real credentials only here; .env is ignored.
# Empty Telegram token starts only the usable web panel/API. No fake LLM in normal mode.
TELEGRAM_BOT_TOKEN=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
# Previously exercised Groq alternative (provider availability may change):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b
# Groq live scenarios passed; see docs/verification.md.
# For this provider, the verified local setup uses LLM_TIMEOUT=60s.
LLM_TIMEOUT=30s
APP_TIMEZONE=Europe/Moscow
PORT=8080
# Local disposable database credential. Use URL-safe characters if overriding.
POSTGRES_PASSWORD=expenses-local-only
